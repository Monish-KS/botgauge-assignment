{
	"info": {
		"_postman_id": "key-value-api-collection",
		"name": "Key-Value API",
		"description": "Key-Value REST API – create, get, update, delete, list items. Rate limit: 60 req/min per client.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000"
		},
		{
			"key": "key",
			"value": "test_key"
		}
	],
	"item": [
		{
			"name": "Root",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/",
					"host": ["{{base_url}}"],
					"path": [""]
				},
				"description": "Health / root. Not rate-limited."
			}
		},
		{
			"name": "Create Item",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"key\": \"{{key}}\",\n  \"value\": \"my value\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/items/",
					"host": ["{{base_url}}"],
					"path": ["items", ""]
				},
				"description": "Create a new key-value item. Returns 409 if key already exists."
			}
		},
		{
			"name": "Get Item",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/items/{{key}}",
					"host": ["{{base_url}}"],
					"path": ["items", "{{key}}"]
				},
				"description": "Get item by key. Returns 404 if not found."
			}
		},
		{
			"name": "Update Item",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"value\": \"updated value\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/items/{{key}}",
					"host": ["{{base_url}}"],
					"path": ["items", "{{key}}"]
				},
				"description": "Update value for key. Returns 404 if not found."
			}
		},
		{
			"name": "Delete Item",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{base_url}}/items/{{key}}",
					"host": ["{{base_url}}"],
					"path": ["items", "{{key}}"]
				},
				"description": "Delete item by key. Returns 404 if not found."
			}
		},
		{
			"name": "List Items",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/items/?page=1&page_size=10",
					"host": ["{{base_url}}"],
					"path": ["items", ""],
					"query": [
						{
							"key": "page",
							"value": "1",
							"description": "Page number (≥1)"
						},
						{
							"key": "page_size",
							"value": "10",
							"description": "Items per page (1–100)"
						}
					]
				},
				"description": "List items with pagination. Returns items, total, page, page_size."
			}
		}
	]
}
